{
  "name": "pi-pwsh-notify-secure",
  "version": "0.5.0-secure.5",
  "description": "Security-hardened private PowerShell extension for Pi with reliable foreground/background execution and metadata-only notifications",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --experimental-strip-types --test test/run-tests.mts",
    "check:upstream": "node scripts/check-upstream.mts",
    "check": "npm run typecheck && npm test && npm run test:integration"
  },
  "license": "MIT",
  "author": "oversk7 (upstream)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radioflyer28/pi-pwsh-notify-secure.git"
  },
  "homepage": "https://github.com/radioflyer28/pi-pwsh-notify-secure#readme",
  "bugs": {
    "url": "https://github.com/radioflyer28/pi-pwsh-notify-secure/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "powershell",
    "pwsh",
    "windows",
    "background-jobs",
    "shell",
    "ai-agent"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.3",
    "@earendil-works/pi-tui": ">=0.84.3",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^24.0.0",
    "jiti": "2.7.0",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  }
}
