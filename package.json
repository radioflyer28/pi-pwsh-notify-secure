{
  "name": "pi-pwsh-notify",
  "version": "0.4.1",
  "description": "pi extension: PowerShell 7 shell for Windows with Claude Code-style background jobs — completion/server-ready notifications steered to the agent mid-turn (batched, never stale), blocking wait (Monitor-style), no polling, persistent cd",
  "type": "module",
  "license": "MIT",
  "author": "oversk7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oversk7/pi-pwsh-notify.git"
  },
  "homepage": "https://github.com/oversk7/pi-pwsh-notify#readme",
  "bugs": {
    "url": "https://github.com/oversk7/pi-pwsh-notify/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "powershell",
    "pwsh",
    "windows",
    "background-jobs",
    "shell",
    "ai-agent"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": ">=0.84.0",
    "@sinclair/typebox": ">=0.30.0"
  }
}
